<%# ============================================
    FORMULARIO DE NUEVO COMENTARIO
    turbo_frame_tag con id "comment_form" permite
    que Turbo Stream lo reemplace después de enviar
    ============================================ %>

<%= turbo_frame_tag "comment_form" do %>
  <%= form_with model: [list, task, comment],
        class: "flex gap-2 mt-3" do |f| %>

    <%# Avatar del usuario actual %>
    <div class="w-7 h-7 rounded-full bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-300 shrink-0 mt-1">
      <%= Current.user.email_address[0].upcase %>
    </div>

    <div class="flex-1 flex gap-2">
      <%# textarea para escribir el comentario %>
      <%= f.text_area :content,
            rows: 1,
            placeholder: "Escribe un comentario...",
            class: "flex-1 bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 resize-none" %>

      <%= f.submit "Enviar",
            class: "text-sm bg-blue-600 hover:bg-blue-500 text-white px-3 py-1 rounded-lg cursor-pointer transition-colors shrink-0" %>
    </div>

  <% end %>
<% end %>