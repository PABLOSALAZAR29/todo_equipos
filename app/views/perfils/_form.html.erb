<%# ============================================
    FORMULARIO DE PERFIL
    Este parcial se usa tanto en edit como en show
    cuando el usuario no tiene perfil creado
    ============================================ %>

<%= form_with model: perfil, url: perfil_path, class: "flex flex-col gap-5", multipart: true do |f| %>

  <%# ---------- SECCIÓN FOTO ----------
      multipart: true es necesario para subir archivos
      sin eso Active Storage no funciona %>
  <div class="flex flex-col items-center gap-4 p-6 bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl border-2 border-gray-700 shadow-sm">
    <div class="relative">

      <%# Si ya tiene foto la muestra, si no muestra un ícono genérico %>
      <% if perfil.foto.attached? %>
        <%= image_tag perfil.foto,
              class: "w-24 h-24 rounded-full object-cover border-4 border-gray-600 shadow-xl" %>
      <% else %>
        <div class="w-24 h-24 rounded-full bg-gray-700 border-4 border-gray-600 flex items-center justify-center text-gray-400 text-5xl shadow-xl">
          &#128100;
        </div>
      <% end %>

      <%# Botón para cambiar foto — está encima de la foto con posición absoluta %>
      <label class="absolute bottom-1 right-1 bg-blue-600 hover:bg-blue-500 text-white rounded-full p-2 cursor-pointer shadow-lg transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <%# El input está oculto, el label lo activa al hacer clic %>
        <%= f.file_field :foto, accept: "image/*", class: "hidden" %>
      </label>
    </div>

    <div class="text-center w-full">
      <%= f.label :foto, "Foto de perfil",
            class: "text-sm font-semibold text-gray-300 block" %>
      <p class="text-xs text-gray-500 mt-1">JPG, PNG • Máx. 5MB</p>
    </div>
  </div>

  <%# ---------- SECCIÓN DATOS PERSONALES ---------- %>
  <div>
    <%# Título de sección — uppercase y tracking-wide dan el estilo de etiqueta %>
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-4">
      Datos personales
    </p>

    <%# Grid de 2 columnas para los nombres %>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :primer_nombre, "Primer nombre",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :primer_nombre,
              placeholder: "Juan",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :segundo_nombre, "Segundo nombre",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :segundo_nombre,
              placeholder: "Carlos",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :primer_apellido, "Primer apellido",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :primer_apellido,
              placeholder: "García",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :segundo_apellido, "Segundo apellido",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :segundo_apellido,
              placeholder: "López",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>
    </div>
  </div>

  <%# ---------- CÉDULA ----------
      col-span-2 hace que ocupe todo el ancho %>
  <div>
    <%= f.label :cedula, "Cédula",
          class: "text-xs text-gray-400 block mb-1" %>
    <%= f.text_field :cedula,
          placeholder: "1234567890",
          class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
  </div>

  <%# ---------- SECCIÓN CONTACTO Y UBICACIÓN ----------
      border-t crea la línea separadora entre secciones %>
  <div class="border-t border-gray-700 pt-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-4">
      Contacto y ubicación
    </p>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :celular, "Celular",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :celular,
              placeholder: "300 123 4567",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :ciudad, "Ciudad",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :ciudad,
              placeholder: "Medellín",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :departamento, "Departamento",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :departamento,
              placeholder: "Antioquia",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :direccion, "Dirección",
              class: "text-xs text-gray-400 block mb-1" %>
        <%= f.text_field :direccion,
              placeholder: "Calle 10 # 20-30",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
      </div>
    </div>
  </div>

  <%# ---------- SECCIÓN INFORMACIÓN LABORAL ---------- %>
  <div class="border-t border-gray-700 pt-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-4">
      Información laboral
    </p>

    <div>
      <%= f.label :cargo, "Cargo",
            class: "text-xs text-gray-400 block mb-1" %>
      <%= f.text_field :cargo,
            placeholder: "Desarrollador Junior",
            class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500" %>
    </div>
  </div>

  <%# ---------- BOTONES ----------
      justify-end empuja los botones a la derecha %>
  <div class="border-t border-gray-700 pt-5 flex justify-end gap-2">

    <%# Botón cancelar — lleva de vuelta al perfil sin guardar %>
    <%= link_to "Cancelar", perfil_path,
          class: "text-sm text-gray-400 border border-gray-600 rounded-lg px-4 py-2 hover:bg-gray-700 transition-colors" %>

    <%# Botón guardar — bg-transparent es necesario porque f.submit tiene estilos propios del browser %>
    <%= f.submit "Guardar cambios",
          class: "text-sm text-blue-400 border border-blue-800 rounded-lg px-4 py-2 hover:bg-blue-900 cursor-pointer bg-transparent transition-colors" %>
  </div>

<% end %>