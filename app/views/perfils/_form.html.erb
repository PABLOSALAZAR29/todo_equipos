<%= form_with model: perfil, url: perfil_path, class: "flex flex-col gap-5", multipart: true do |f| %>
  <%# Foto de perfil %>
  <div class="flex flex-col items-center gap-4 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border-2 border-blue-100 shadow-sm">
    <div class="relative">
      <% if perfil.foto.attached? %>
        <%= image_tag perfil.foto, class: "w-48 h-48 rounded-full object-cover border-4 border-white shadow-xl" %>
      <% else %>
        <div class="w-48 h-48 rounded-full bg-gray-200 border-4 border-white flex items-center justify-center text-gray-400 text-7xl shadow-xl">
          &#128100;
        </div>
      <% end %>
      <label class="absolute bottom-2 right-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full p-3 cursor-pointer shadow-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <%= f.file_field :foto, accept: "image/*", class: "hidden" %>
      </label>
    </div>
    <div class="text-center w-full">
      <%= f.label :foto, "Foto de perfil", class: "text-sm font-semibold text-gray-700 block" %>
      <p class="text-xs text-gray-500 mt-1">JPG, PNG • Máx. 5MB</p>
    </div>
  </div>

  <%# Datos personales %>
  <div>
    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-4">Datos personales</p>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :primer_nombre, "Primer nombre", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :primer_nombre, placeholder: "Juan",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :segundo_nombre, "Segundo nombre", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :segundo_nombre, placeholder: "Carlos",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :primer_apellido, "Primer apellido", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :primer_apellido, placeholder: "García",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :segundo_apellido, "Segundo apellido", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :segundo_apellido, placeholder: "López",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
    </div>
  </div>
   
  <div class="col-span-2">
  <%= f.label :cedula, "Cédula", class: "text-xs text-gray-500 block mb-1" %>
  <%= f.text_field :cedula, placeholder: "1234567890",
        class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
  </div>

  <%# Contacto y ubicación %>
  <div class="border-t border-gray-100 pt-5">
    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-4">Contacto y ubicación</p>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :celular, "Celular", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :celular, placeholder: "300 123 4567",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :ciudad, "Ciudad", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :ciudad, placeholder: "Medellín",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :departamento, "Departamento", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :departamento, placeholder: "Antioquia",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
      <div>
        <%= f.label :direccion, "Dirección", class: "text-xs text-gray-500 block mb-1" %>
        <%= f.text_field :direccion, placeholder: "Calle 10 # 20-30",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
      </div>
    </div>
  </div>

  <%# Información laboral %>
  <div class="border-t border-gray-100 pt-5">
    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-4">Información laboral</p>
    <div>
      <%= f.label :cargo, "Cargo", class: "text-xs text-gray-500 block mb-1" %>
      <%= f.text_field :cargo, placeholder: "Desarrollador Junior",
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-300" %>
    </div>
  </div>

  <%# Botones %>
  <div class="border-t border-gray-100 pt-5 flex justify-end gap-2">
    <%= link_to "Cancelar", perfil_path,
          class: "text-sm text-gray-500 border border-gray-200 rounded-lg px-4 py-2 hover:bg-gray-50" %>
    <%= f.submit "Guardar cambios",
          class: "text-sm text-blue-500 border border-blue-200 rounded-lg px-4 py-2 hover:bg-blue-50 cursor-pointer bg-transparent" %>
  </div>

<% end %>