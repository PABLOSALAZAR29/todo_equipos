<%# ============================================
    FORMULARIO NUEVA TAREA
    [@list, @task] le dice a Rails que esta tarea
    pertenece a una lista — genera la URL correcta
    /lists/:list_id/tasks
    ============================================ %>

<div class="max-w-xl mx-auto mt-10">

  <%# Encabezado con título y link de regreso %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-white">Nueva tarea</h1>
    <%= link_to "← Volver a la lista", @list,
          class: "text-sm text-gray-400 hover:text-gray-200 transition-colors" %>
  </div>

  <%# bg-gray-800 es la tarjeta oscura, shadow-sm da profundidad sutil %>
  <%= form_with model: [@list, @task],
        class: "bg-gray-800 border border-gray-700 rounded-lg p-6 shadow-sm space-y-4" do |f| %>

    <%# Errores de validación — solo aparece si hay errores %>
    <% if @task.errors.any? %>
      <div class="text-sm text-red-400 bg-red-900 border border-red-700 rounded p-3">
        <% @task.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%# ---------- TÍTULO — campo obligatorio ---------- %>
    <div>
      <%= f.label :title, "Título",
            class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.text_field :title,
            placeholder: "Nombre de la tarea",
            class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%# ---------- DESCRIPCIÓN — campo opcional
        text_area permite múltiples líneas
        rows: 3 define la altura inicial %>
    <div>
      <%= f.label :description, "Descripción",
            class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.text_area :description,
            rows: 3,
            placeholder: "Detalles de la tarea (opcional)",
            class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%# ---------- FECHA LÍMITE — campo opcional
        date_field muestra el selector de fecha del browser %>
    <div>
      <%= f.label :due_date, "Fecha límite",
            class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.date_field :due_date,
            class: "w-full bg-gray-700 border border-gray-600 text-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%# Botón de envío — w-full ocupa todo el ancho %>
    <%= f.submit "Crear tarea",
          class: "w-full bg-blue-600 text-white text-sm font-medium py-2 rounded-md hover:bg-blue-700 cursor-pointer transition-colors" %>

  <% end %>
</div>