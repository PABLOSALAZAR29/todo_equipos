<div class="max-w-xl mx-auto mt-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Nueva tarea</h1>
    <%= link_to "← Volver a la lista", @list, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: [@list, @task], class: "bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-4" do |f| %>
    <% if @task.errors.any? %>
      <div class="text-sm text-red-600 bg-red-50 border border-red-200 rounded p-3">
        <% @task.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Título", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Nombre de la tarea" %>
    </div>

    <%= f.submit "Crear tarea", class: "w-full bg-blue-600 text-white text-sm font-medium py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>
