<div class="max-w-5xl mx-auto py-8 px-4">

  <%# Encabezado %>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Directorio</h1>
      <p class="text-sm text-gray-400 mt-1">
        <%= @users.count %> miembros en el equipo
      </p>
    </div>
  </div>

  <%# Grid de tarjetas %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @users.each do |user| %>

      <div class="bg-gray-800 border border-gray-700 rounded-xl p-5 flex flex-col items-center text-center gap-3 hover:border-gray-500 transition-colors">

        <%# Foto o avatar %>
        <% if user.perfil&.foto&.attached? %>
          <%= image_tag user.perfil.foto,
                class: "w-20 h-20 rounded-full object-cover border-2 border-gray-600" %>
        <% else %>
          <div class="w-20 h-20 rounded-full bg-gray-700 border-2 border-gray-600 flex items-center justify-center text-2xl font-bold text-gray-300">
            <%= user.email_address[0].upcase %>
          </div>
        <% end %>

        <%# Nombre y cargo %>
        <div>
          <p class="text-white font-semibold text-sm">
            <%= user.perfil&.nombre_completo&.presence || "Sin nombre" %>
          </p>
          <% if user.perfil&.cargo.present? %>
            <p class="text-gray-400 text-xs mt-0.5"><%= user.perfil.cargo %></p>
          <% end %>
        </div>

        <%# Separador %>
        <div class="w-full border-t border-gray-700"></div>

        <%# Datos de contacto %>
        <div class="w-full flex flex-col gap-1.5 text-left">

          <div class="flex items-center gap-2 text-xs text-gray-400">
            <span>✉️</span>
            <span class="truncate"><%= user.email_address %></span>
          </div>

          <% if user.perfil&.celular.present? %>
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <span>📱</span>
              <span><%= user.perfil.celular %></span>
            </div>
          <% end %>

          <% if user.perfil&.ciudad.present? %>
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <span>📍</span>
              <span><%= user.perfil.ciudad %>, <%= user.perfil.departamento %></span>
            </div>
          <% end %>

          <% if user.perfil&.cedula.present? %>
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <span>🪪</span>
              <span><%= user.perfil.cedula %></span>
            </div>
          <% end %>

        </div>

        <%# Badge de rol %>
        <span class="text-xs px-3 py-1 rounded-full font-medium
              <%= user.admin? ? 'bg-red-900 text-red-300 border border-red-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
          <%= user.admin? ? "Admin" : "Usuario" %>
        </span>

      </div>

    <% end %>
  </div>

</div>