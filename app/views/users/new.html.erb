<div class="min-h-screen flex items-center justify-center bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 border border-gray-700 rounded-2xl shadow-xl p-8">
    <h1 class="text-3xl font-bold text-white mb-2 text-center">Crear cuenta</h1>
    <p class="text-sm text-gray-400 text-center mb-6">Completa los datos para registrarte</p>

    <% if @user.errors.any? %>
      <div class="bg-red-900 border border-red-700 text-red-300 text-sm rounded-lg px-4 py-3 mb-5">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user, url: users_path, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email_address, "Correo electrónico",
              class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.email_field :email_address,
              required: true,
              autofocus: true,
              placeholder: "tu@correo.com",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :password, "Contraseña",
              class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.password_field :password,
              required: true,
              placeholder: "••••••••",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar contraseña",
              class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.password_field :password_confirmation,
              required: true,
              placeholder: "••••••••",
              class: "w-full bg-gray-700 border border-gray-600 text-gray-200 placeholder-gray-500 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <%= f.submit "Crear cuenta",
            class: "w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2.5 rounded-lg cursor-pointer transition-colors" %>
    <% end %>

    <p class="text-center text-sm text-gray-500 mt-6">
      ¿Ya tienes cuenta?
      <%= link_to "Inicia sesión", new_session_path,
            class: "text-blue-400 font-medium hover:underline" %>
    </p>
  </div>
</div>