<div class="max-w-xl mx-auto mt-10" data-controller="filtro">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800"><%= @list.title %></h1>
    <div class="flex items-center gap-3">
      <% if Current.user.admin? %>
        <%= link_to "Nueva tarea", new_list_task_path(@list), class: "text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700" %>
      <% end %>
      <%= link_to "← Mis listas", lists_path, class: "text-sm text-blue-600 hover:underline" %>
    </div>
  </div>

   <div class="mb-4">
    <input type="text"
           data-filtro-target="input"
           data-action="input->filtro#filtrar"
           placeholder="Buscar tarea..."
           class="w-full border border-gray-200 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-blue-300">
  </div>

  <% if @tasks.any? %>
    <ul class="space-y-2">
      <% @tasks.each do |task| %>
        <li data-filtro-target="tarea"
            data-titulo="<%= task.title %>"
            class="flex items-center gap-3 bg-white border border-gray-200 rounded-lg px-4 py-3 shadow-sm">
          <span class="<%= task.completed? ? 'line-through text-gray-400' : 'text-gray-700' %> text-sm flex-1">
            <%= task.title %>
          </span>
          <span class="text-xs px-2 py-0.5 rounded-full <%= task.completed? ? 'bg-green-100 text-green-600' : 'bg-yellow-100 text-yellow-600' %>">
            <%= task.completed? ? "Completada" : "Pendiente" %>
          </span>
          <%= form_with url: toggle_completed_list_task_path(@list, task), method: :patch, class: "ml-2" do %>
            <%= submit_tag task.completed? ? "Marcar pendiente" : "Marcar completada", class: "text-xs bg-blue-500 text-white px-2 py-1 rounded hover:bg-blue-600" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-400 text-sm text-center mt-10">No hay tareas en esta lista todavía.</p>
  <% end %>
</div>
