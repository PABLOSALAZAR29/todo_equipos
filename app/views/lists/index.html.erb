<h1>Mis Listas de Tareas</h1>

<%= link_to "Nueva Lista", new_list_path, class: "btn btn-primary" %>

<ul>
  <% @lists.each do |list| %>
    <li>
      <%= link_to list.title, list %>  <!-- por ahora sin show, pero lo ponemos -->
      (<%= list.tasks.count %> tareas)
      <%= link_to "Editar", edit_list_path(list) %>
      <%= link_to "Eliminar", list, method: :delete, data: { confirm: "¿Seguro?" } %>
    </li>
  <% end %>
</ul>

<% if @lists.empty? %>
  <p>Aún no tienes listas. ¡Crea una!</p>
<% end %>