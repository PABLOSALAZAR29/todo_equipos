<div class="max-w-2xl mx-auto py-8 px-4" data-controller="filtro">

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-medium text-white">Listas de tareas</h1>
    <% if Current.user.admin? %>
      <%= link_to "+ Nueva lista", new_list_path,
            class: "text-sm border border-gray-600 rounded-lg px-4 py-2 text-gray-300 hover:bg-gray-700 transition-colors" %>
    <% end %>
  </div>

  <div class="mb-4">
    <input type="text"
           data-filtro-target="input"
           data-action="input->filtro#filtrar"
           placeholder="Buscar lista..."
           class="w-full border border-gray-200 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-blue-300">
  </div>

  <% if Current.user.admin? %>
    <% if @users_with_lists.empty? %>
      <p class="text-gray-500 text-sm text-center py-12">No hay usuarios registrados.</p>
    <% else %>
      <% @users_with_lists.each do |user| %>
        <div class="mb-8">
          <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">
            <%= user.email_address %>
          </h2>
          <% if user.lists.empty? %>
            <p class="text-gray-600 text-sm pl-2">Sin listas.</p>
          <% else %>
            <div class="flex flex-col gap-3">
              <% user.lists.each do |list| %>
                <div data-filtro-target="tarea"
                    data-titulo="<%= list.title %>"
                 class="bg-gray-800 border border-gray-700 rounded-lg px-5 py-4 flex items-center justify-between hover:border-gray-500 transition-colors">
                  <div>
                    <p class="text-sm font-medium text-gray-200"><%= list.title %></p>
                    <p class="text-xs text-gray-500 mt-0.5"><%= list.tasks.count %> tareas</p>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= link_to "Ver", list,
                          class: "text-sm text-blue-400 border border-blue-800 rounded-md px-3 py-1.5 hover:bg-blue-900 transition-colors" %>
                    <%= link_to "Editar", edit_list_path(list),
                          class: "text-sm text-gray-400 border border-gray-600 rounded-md px-3 py-1.5 hover:bg-gray-700 transition-colors" %>
                    <%= button_to "Eliminar", list, method: :delete,
                          class: "text-sm text-red-400 border border-red-800 rounded-md px-3 py-1.5 hover:bg-red-900 transition-colors bg-transparent cursor-pointer",
                          data: { turbo_confirm: "¿Estás seguro?" } %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

  <% else %>
    <% if @lists.empty? %>
      <div class="text-center py-12 border border-dashed border-gray-700 rounded-lg">
        <p class="text-gray-500 text-sm">Aún no tienes listas.</p>
      </div>
    <% else %>
      <div class="flex flex-col gap-3">
        <% @lists.each do |list| %>
          <div class="bg-gray-800 border border-gray-700 rounded-lg px-5 py-4 flex items-center justify-between hover:border-gray-500 transition-colors">
            <div>
              <p class="text-sm font-medium text-gray-200"><%= list.title %></p>
              <p class="text-xs text-gray-500 mt-0.5"><%= list.tasks.count %> tareas</p>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to "Ver", list,
                    class: "text-sm text-blue-400 border border-blue-800 rounded-md px-3 py-1.5 hover:bg-blue-900 transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

</div>